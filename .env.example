# Solo credenciales de MySQL para Docker Compose.
DB_DATABASE=cultiva
DB_USER=cultiva_app
DB_PASSWORD=REEMPLAZAR
DB_ROOT_PASSWORD=REEMPLAZAR

# Solo para docker-compose.production.yml; apunta el registro DNS al servidor.
API_DOMAIN=api.ejemplo.com
# Origen HTTPS del frontend web; puede quedar vacío si solo se usa la app móvil.
CORS_ORIGINS=
