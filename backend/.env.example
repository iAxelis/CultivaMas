# Minimo para ejecutar NestJS directamente en la maquina local.
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://root:root@localhost:3306/cultiva

# Genera dos valores distintos de al menos 64 caracteres.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
JWT_REFRESH_SECRET=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO_DE_64_CARACTERES

# Solo para desarrollo local con MySQL; produccion lo prohibe.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
